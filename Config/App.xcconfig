// Shared build settings. Put your own signing values in
// Config/Signing.local.xcconfig (git-ignored), e.g.:
//   PRODUCT_BUNDLE_IDENTIFIER = com.yourname.holyarrs
//   DEVELOPMENT_TEAM = ABCDE12345
PRODUCT_BUNDLE_IDENTIFIER = com.example.holyarrs
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Signing.local.xcconfig"
